{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/diff", "destination": "/diff.html" },
      { "source": "/schema-validator", "destination": "/schema-validator.html" },
      { "source": "/jsonpath", "destination": "/jsonpath.html" },
      { "source": "/converter", "destination": "/converter.html" },
      { "source": "/repair", "destination": "/repair.html" },
      { "source": "/graph", "destination": "/graph.html" },
      { "source": "/table", "destination": "/table.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "@(robots.txt|sitemap.xml|google*.html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ]
  }
}
